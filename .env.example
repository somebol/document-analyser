# Copy to .env if needed; applications load it from the project working directory.
# Environment variables override .env, which overrides config.py defaults.

# Infrastructure and storage (these example credentials are for local development).
DATABASE_URL=postgresql+psycopg://analyser:analyser@localhost:5432/analyser
DOCUMENT_STORAGE_DIR=data/storage
DOCUMENT_API_URL=http://127.0.0.1:8000
QDRANT_URL=http://localhost:6333
MAX_UPLOAD_BYTES=104857600
QDRANT_TIMEOUT=120

# Ollama: the embedding adapter uses Nomic search_document/search_query prefixes.
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_TIMEOUT=120
EMBEDDING_BATCH_SIZE=16
GENERATION_MODEL=qwen3:8b
GENERATION_TIMEOUT=300
GENERATION_TEMPERATURE=0
GENERATION_CONTEXT_TOKENS=8192
GENERATION_MAX_TOKENS=1500

# Retrieval and summaries (budgets are characters, not model tokens).
RETRIEVAL_LIMIT=5
SUMMARY_BATCH_CHARACTERS=10000
SUMMARY_MAX_LEVELS=8

# Saved with each new processing version; overlap must be smaller than max words.
CHUNK_MAX_WORDS=120
CHUNK_OVERLAP_WORDS=20
CHUNK_MAX_CHARACTERS=1600

# Unreviewed NER candidates. Keep model and tokenizer compatible.
NER_MODEL=urchade/gliner_large-v2.1
NER_TOKENIZER=microsoft/deberta-v3-large
NER_LABELS='["person name","organization name","geographical location"]'
NER_THRESHOLD=0.5
NER_WINDOW_TOKENS=192
NER_OVERLAP_TOKENS=32

# Poll intervals and HTTP timeouts, in seconds.
WORKER_POLL_SECONDS=2
UI_POLL_SECONDS=3
API_REQUEST_TIMEOUT=10
UPLOAD_REQUEST_TIMEOUT=120
CHAT_REQUEST_TIMEOUT=900
